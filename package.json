{
  "name": "hack-party",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest --maxWorkers=2",
    "test:clearCache": "jest --clearCache",
    "test:inspect": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "axios": "^1.21.0",
    "gsap": "^3.15.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pug": "^3.0.4",
    "reveal.js": "^5.2.1",
    "uuid": "^13.0.2",
    "vue": "^3.5.45",
    "vue-advanced-chat": "file:vendor/vue-advanced-chat",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@pinia/testing": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "flush-promises": "^1.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.7",
    "vue-eslint-parser": "^10.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue}": "eslint"
  },
  "overrides": {
    "@vue/vue3-jest": {
      "jest": "$jest"
    }
  }
}
